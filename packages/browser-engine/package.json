{
  "name": "@earendil-works/pi-browser",
  "version": "0.84.2",
  "description": "Browser/hosted Pi harness with an outbound executor channel for shared PiServer sessions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "node build.mjs",
    "test": "vitest --run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
		"rollup": "4.63.6",
    "rollup-plugin-dts": "6.5.1",
    "vitest": "4.1.9"
  },
  "keywords": [
    "ai",
    "agent",
    "browser",
    "harness",
    "llm"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi.git",
    "directory": "packages/browser-engine"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@silvia-odwyer/photon-node": "0.3.4",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-client": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-protocol": "^0.84.2",
    "@earendil-works/pi-session-protocol": "^0.84.2"
  }
}
