{
  "name": "@earendil-works/pi-browser",
  "version": "0.84.2",
  "description": "pi harness packaged for the browser/hosted profiles: single createPiHarness entry (15-F)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "browser",
    "harness",
    "llm"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi.git",
    "directory": "packages/browser-engine"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@silvia-odwyer/photon-node": "0.3.4",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "workspace:*",
    "@earendil-works/pi-ai": "workspace:*",
    "@earendil-works/pi-coding-agent": "workspace:*",
    "@earendil-works/pi-client": "workspace:*"
  }
}
